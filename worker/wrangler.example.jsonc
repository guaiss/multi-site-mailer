// Copy to wrangler.jsonc (git-ignored) and fill in the REPLACE_ME values,
// or run `node scripts/setup.mjs` which creates the resources and writes it for you.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // docs/ai-*.md are bundled and served at /api/v1/llms.txt and /api/v1/llms-mail.txt.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // One hostname for everything: admin UI + /api/admin (behind Cloudflare Access)
  // and the machine API at /api/v1 (Access bypass app; key/token auth).
  "routes": [{ "pattern": "REPLACE_ME_HOSTNAME", "custom_domain": true }],

  // Built SPA from ../web. The Worker runs first so /api is never shadowed by assets.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailer",
      "database_id": "REPLACE_ME_D1_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Raw .eml, HTML bodies, attachments.
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "mailer-mail" }],

  "send_email": [{ "name": "EMAIL" }],

  // Per-site / per-token burst limit. Daily quota lives in D1.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "vars": {
    // Zero Trust team domain, e.g. "myteam.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "REPLACE_ME_TEAM.cloudflareaccess.com",
    // Audience (AUD) tag of the Access application protecting the hostname.
    "ACCESS_AUD": "REPLACE_ME_ACCESS_AUD",
    // Comma-separated emails allowed into the admin UI (must also pass the Access policy).
    "ADMIN_EMAILS": "REPLACE_ME_ADMIN_EMAIL",
    // Optional: authserv-id of Cloudflare's Authentication-Results header.
    "TRUSTED_AUTHSERV_ID": ""
  }
}
